# Copy to .env and fill in with your own Lovable Cloud / Supabase project values.
# These are PUBLISHABLE values — safe to expose in the client bundle.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Set as an Edge Function secret (NOT in this file) in your Supabase/Lovable Cloud project:
#   LOVABLE_API_KEY=...
